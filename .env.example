# URL Виртуальной АТС, например https://domain/sys/crm_api.wcgp
ATS_API_URL=

# Ключ (token) Виртуальной АТС из веб-кабинета
ATS_TOKEN=

# Как часто опрашивать пропущенные звонки, минут
POLL_MISSED_INTERVAL_MIN=5

# Как часто опрашивать исходящие звонки (для поиска перезвонов), минут
POLL_OUTGOING_INTERVAL_MIN=5

# Как часто проверять, не истекло ли время на перезвон, минут
WATCHDOG_INTERVAL_MIN=1

# Через сколько минут без перезвона отправлять алерт в Telegram
CALLBACK_TIMEOUT_MIN=15

# Токен Telegram-бота (от @BotFather)
TELEGRAM_BOT_TOKEN=

# ID чата/группы, куда отправлять уведомления
TELEGRAM_CHAT_ID=

# Путь к файлу SQLite
DB_PATH=./data/state.db
